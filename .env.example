# ARGUS Environment Variables
# Copy this file to .env and fill in your values

# ── Required for production ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please

# ── Frontend (set in Vercel environment variables) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional — add free API keys for richer IOC enrichment ───────────────────
# AlienVault OTX (free): https://otx.alienvault.com/settings
OTX_API_KEY=

# VirusTotal (free, 1k req/day): https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# GreyNoise community (free, 500 req/month): https://viz.greynoise.io/account/
GREYNOISE_API_KEY=

# Abuse.ch (free): https://abuse.ch/api/ — needed for ThreatFox & MalwareBazaar
ABUSECH_API_KEY=

# ── Set automatically by Railway / Docker Compose in production ───────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/argus
# REDIS_URL=redis://host:6379
