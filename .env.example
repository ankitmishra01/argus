# ARGUS Environment Variables
# Copy this file to .env and fill in your values

# Required for production — change this
SECRET_KEY=change-me-in-production-please

# Optional — free accounts at the respective services
# AlienVault OTX: https://otx.alienvault.com/settings
OTX_API_KEY=

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# GreyNoise: https://viz.greynoise.io/account/
GREYNOISE_API_KEY=

# Set automatically by Railway in production
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/argus
# REDIS_URL=redis://host:6379
